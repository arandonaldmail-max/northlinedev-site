---
interface Props {
	title: string;
	description?: string;
}

const { title, description = "Northline Grid™: The growth infrastructure for elite roofing enterprises." } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		
		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
	</head>
	<body>
		<div class="blueprint-overlay"></div>
		<div class="noise-filter"></div>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		/* Tactical Palette - Anduril/SpaceX Style */
		--bg: #02040a;
		--bg-alt: #050810;
		--tactical-blue: #1d63ff;
		--tactical-blue-dim: rgba(29, 99, 255, 0.15);
		--steel: #e2e8f0;
		--steel-dim: rgba(226, 232, 240, 0.4);
		--line: rgba(255, 255, 255, 0.04);
		--line-heavy: rgba(255, 255, 255, 0.08);
		
		/* System Constants */
		--max-width: 1320px;
		--radius-tactical: 2px; /* Hard edges, industrial feel */
		--font-mono: 'JetBrains Mono', monospace;
		
		/* Spacing */
		--unit: 4px;
		--s-16: calc(var(--unit) * 4);
		--s-32: calc(var(--unit) * 8);
		--s-64: calc(var(--unit) * 16);
		--s-128: calc(var(--unit) * 32);
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		scroll-behavior: smooth;
		-webkit-font-smoothing: antialiased;
		background: var(--bg);
	}

	body {
		background: var(--bg);
		color: var(--steel);
		font-family: 'Inter', system-ui, sans-serif;
		line-height: 1.5;
		overflow-x: hidden;
	}

	.blueprint-overlay {
		position: fixed;
		top: 0; left: 0; right: 0; bottom: 0;
		background-image: 
			linear-gradient(var(--line) 1px, transparent 1px),
			linear-gradient(90deg, var(--line) 1px, transparent 1px);
		background-size: 40px 40px;
		pointer-events: none;
		z-index: 1;
	}

	.noise-filter {
		position: fixed;
		top: 0; left: 0; width: 100%; height: 100%;
		background: url('https://grainy-gradients.vercel.app/noise.svg');
		opacity: 0.03;
		pointer-events: none;
		z-index: 2;
	}

	/* Tactical Typography */
	h1, h2, h3 {
		text-transform: uppercase;
		font-weight: 900;
		letter-spacing: -0.04em;
		line-height: 0.95;
	}

	.mono {
		font-family: var(--font-mono);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-size: 0.75rem;
	}

	/* Sectioning */
	.container {
		width: min(calc(100% - 64px), var(--max-width));
		margin-inline: auto;
		position: relative;
		z-index: 10;
	}

	/* Reveal Animation */
	@keyframes tactical-reveal {
		from { opacity: 0; transform: translateY(10px); filter: blur(4px); }
		to { opacity: 1; transform: translateY(0); filter: blur(0); }
	}

	.reveal {
		animation: tactical-reveal 0.8s cubic-bezier(0.19, 1, 0.22, 1) forwards;
	}

	/* Links & Interactive */
	a { color: inherit; text-decoration: none; }

	::selection {
		background: var(--tactical-blue);
		color: #fff;
	}

	@media (max-width: 768px) {
		.container { width: min(calc(100% - 32px), var(--max-width)); }
	}
</style>
