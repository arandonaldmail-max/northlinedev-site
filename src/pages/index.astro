---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import FeatureCard from '../components/FeatureCard.astro';
import Button from '../components/Button.astro';


const bookingLink = "/enquire/";

const techIcons = {
	terminal: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>`,
	pulse: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>`,
	shield: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>`,
	database: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>`
};
---

<Layout title="NorthlineDev | Professional websites for service businesses">
	<Header />
	
	<main>
		<Hero />

		<!-- The Thesis -->
		<Section 
			id="services"
			eyebrow="The Infrastructure Thesis"
			title="Fragmented Tech is <br/>Architectural Failure."
			description="Bring your services, project examples and customer enquiry routes together in one professional website."
		>
			<div class="thesis-visual">
				<div class="visual-pane reveal">
					<div class="pane-label mono">Illustration // Fragmented customer journey</div>
					<div class="pane-content cloud-chaos">
						<!-- Chaos visual placeholder -->
						<div class="chaos-line"></div>
						<div class="chaos-line"></div>
						<div class="chaos-line"></div>
						<div class="chaos-text mono">Disconnected enquiry routes</div>
					</div>
				</div>
				<div class="visual-pane highlight reveal" style="animation-delay: 0.2s;">
					<div class="pane-label mono">Illustration // Unified website</div>
					<div class="pane-content grid-solid">
						<div class="monolith-icon"></div>
						<div class="grid-stats mono">Clear customer journey</div>
					</div>
				</div>
			</div>

			<div class="module-grid">
				<FeatureCard 
					variant="module"
					number="Mod_01"
					icon={techIcons.terminal}
					title="Frontline Terminal" 
					description="A responsive website that helps visitors understand your services and find an enquiry route."
				/>
				<FeatureCard 
					variant="module"
					number="Mod_02"
					icon={techIcons.pulse}
					title="Response Engine" 
					description="A clear enquiry workflow designed around the information your business needs to respond."
				/>
				<FeatureCard 
					variant="module"
					number="Mod_03"
					icon={techIcons.database}
					title="Command Center" 
					description="We can discuss enquiry tracking and other integrations as separately scoped requirements."
				/>
				<FeatureCard 
					variant="module"
					number="Mod_04"
					icon={techIcons.shield}
					title="Reputation Ledger" 
					description="Showcase your real project photographs and approved customer feedback where available."
				/>
			</div>
		</Section>

		<!-- Pricing / Deployment -->
		<Section 
			id="pricing"
			eyebrow="Infrastructure Deployment"
			title="Clear Scope. <br/>Written Quotes."
			description="Tell us what you need. We will discuss project scope, pricing and any ongoing care in writing."
			dark={true}
		>
			<div class="deployment-grid"><div><h3>New website or redesign</h3><p>Discuss pages, content and enquiry requirements.</p><Button href={bookingLink} variant="tactical">Request a written quote</Button></div><div><h3>Website care</h3><p>Discuss maintenance requirements separately.</p><Button href={bookingLink} variant="ghost">Discuss your project</Button></div></div>
		</Section>

		<!-- Final Access -->
		<Section 
			id="faq"
			title="Initiate <br/>Deployment Protocol."
			description="Tell us about your business and the website you need. We will discuss the next steps by email."
		>
			<div class="access-terminal reveal">
				<div class="terminal-head">
					<div class="mono text-tactical">Terminal_Access: Ready</div>
					<div class="mono text-muted">ID: NL-99-A2</div>
				</div>
				<div class="terminal-body">
					<h3>Request Grid Access</h3>
					<p>Share your project goals and preferred timing. We can agree the scope and a written quote before work begins.</p>
					<div class="terminal-actions">
						<Button href={bookingLink} variant="tactical">Prepare project enquiry</Button>
						<a href="mailto:aran@northlinedev.net" class="mono mail-link">Email: aran@northlinedev.net</a>
					</div>
				</div>
			</div>
		</Section>

	</main>

	<footer class="tactical-footer">
		<div class="container footer-wrap">
			<div class="mono text-muted">© 2026 NorthlineDev // All Rights Reserved</div>
			<div class="footer-links">
				<a href="/enquire/" class="mono">Project enquiry</a>
			</div>
		</div>
	</footer>
</Layout>

<style>
	/* Thesis Visuals */
	.thesis-visual {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2px;
		background: var(--line-heavy);
		border: 1px solid var(--line-heavy);
		margin-bottom: var(--s-64);
	}

	.visual-pane {
		background: var(--bg);
		padding: var(--s-48);
		min-height: 320px;
		display: flex;
		flex-direction: column;
	}

	.pane-label { color: var(--steel-dim); font-size: 0.65rem; margin-bottom: 48px; }

	.cloud-chaos {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 16px;
		position: relative;
		opacity: 0.4;
	}

	.chaos-line { height: 1px; background: var(--line-heavy); width: 80%; }
	.chaos-line:nth-child(2) { width: 60%; transform: translateX(20%); }
	.chaos-line:nth-child(3) { width: 70%; transform: translateX(10%); }

	.chaos-text { margin-top: auto; color: #ef4444; font-size: 0.6rem; }

	.visual-pane.highlight {
		background: var(--bg-alt);
		border: 1px solid var(--tactical-blue);
	}

	.grid-solid {
		flex: 1;
		display: grid;
		place-items: center;
	}

	.monolith-icon {
		width: 48px;
		height: 64px;
		background: #fff;
		clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
		box-shadow: 0 0 40px var(--tactical-blue);
	}

	.grid-stats { margin-top: 48px; color: var(--tactical-blue); font-size: 0.65rem; }

	/* Module Grid */
	.module-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: var(--s-16);
	}

	/* Deployment Grid */
	.deployment-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--s-16);
		max-width: 1000px;
		margin-inline: auto;
	}

	/* Access Terminal */
	.access-terminal {
		background: var(--bg-alt);
		border: 1px solid var(--line-heavy);
		padding: var(--s-64);
		max-width: 800px;
		margin-inline: auto;
		position: relative;
	}

	.terminal-head {
		display: flex;
		justify-content: space-between;
		margin-bottom: 48px;
		border-bottom: 1px solid var(--line);
		padding-bottom: 16px;
	}

	.terminal-body h3 { font-size: 2.5rem; margin-bottom: 24px; color: #fff; }
	.terminal-body p { font-size: 1.15rem; color: var(--steel-dim); margin-bottom: 48px; max-width: 500px; }

	.terminal-actions {
		display: flex;
		align-items: center;
		gap: 32px;
		flex-wrap: wrap;
	}

	.mail-link { font-size: 0.75rem; color: var(--tactical-blue); }

	/* Footer */
	.tactical-footer {
		padding: var(--s-64) 0;
		border-top: 1px solid var(--line);
	}

	.footer-wrap {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.footer-links { display: flex; gap: 32px; }
	.footer-links a { font-size: 0.7rem; color: var(--line-heavy); }
	.footer-links a:hover { color: var(--steel); }

	@media (max-width: 1024px) {
		.thesis-visual, .deployment-grid { grid-template-columns: 1fr; }
		.visual-pane { min-height: 240px; }
		.access-terminal { padding: var(--s-32); }
		.terminal-actions { flex-direction: column; align-items: stretch; }
		.footer-wrap { flex-direction: column; gap: 32px; text-align: center; }
	}
</style>
