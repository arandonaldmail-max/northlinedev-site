---
import Button from './Button.astro';

const navItems = [
	{ label: 'Infrastructure', href: '#services' },
	{ label: 'Blueprint', href: '#process' },
	{ label: 'Ledger', href: '#demo' },
	{ label: 'Terminal', href: '#faq' },
];

const bookingLink = "https://bookings.cloud.microsoft/book/NorthlineDev1@northlinedev.com/?ismsaljsauthenabled";
---

<header class="tactical-header">
	<div class="container header-wrap">
		<div class="header-left">
			<a href="/" class="brand-tactical">
				<div class="brand-monolith">
					<div class="m-box"></div>
					<div class="m-glow"></div>
				</div>
				<div class="brand-text">
					<span class="m-top">Northline</span>
					<span class="m-bottom mono">Infrastructure</span>
				</div>
			</a>
		</div>

		<nav class="header-center">
			<ul class="nav-tactical">
				{navItems.map(item => (
					<li>
						<a href={item.href} class="nav-item reveal">
							<span class="nav-n mono">0{navItems.indexOf(item) + 1}</span>
							<span class="nav-l">{item.label}</span>
						</a>
					</li>
				))}
			</ul>
		</nav>

		<div class="header-right">
			<div class="status-box reveal">
				<span class="status-dot"></span>
				<span class="mono">Grid: Online</span>
			</div>
			<Button href={bookingLink} variant="ghost" className="nav-btn reveal">Request Access</Button>
		</div>
	</div>
</header>

<style>
	.tactical-header {
		position: fixed;
		top: 0; left: 0; width: 100%;
		height: 80px;
		background: rgba(2, 4, 10, 0.8);
		backdrop-filter: blur(20px);
		border-bottom: 1px solid var(--line);
		z-index: 100;
		display: flex;
		align-items: center;
	}

	.header-wrap {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.brand-tactical {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.brand-monolith {
		position: relative;
		width: 24px;
		height: 32px;
	}

	.m-box {
		position: relative;
		width: 100%;
		height: 100%;
		background: #fff;
		clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
		z-index: 2;
	}

	.m-glow {
		position: absolute;
		top: 0; left: 0; width: 100%; height: 100%;
		background: var(--tactical-blue);
		filter: blur(12px);
		opacity: 0.6;
		z-index: 1;
	}

	.brand-text {
		display: flex;
		flex-direction: column;
	}

	.m-top {
		font-weight: 900;
		font-size: 1.1rem;
		letter-spacing: -0.02em;
		color: #fff;
		line-height: 1;
	}

	.m-bottom {
		font-size: 0.6rem;
		color: var(--steel-dim);
		margin-top: 2px;
	}

	.nav-tactical {
		display: flex;
		gap: 48px;
		list-style: none;
	}

	.nav-item {
		display: flex;
		flex-direction: column;
		transition: opacity 0.3s ease;
	}

	.nav-item:hover {
		opacity: 0.7;
	}

	.nav-n {
		font-size: 0.6rem;
		color: var(--tactical-blue);
		margin-bottom: 2px;
	}

	.nav-l {
		font-weight: 700;
		font-size: 0.85rem;
		color: var(--steel);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.header-right {
		display: flex;
		align-items: center;
		gap: 32px;
	}

	.status-box {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 8px 16px;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid var(--line);
		border-radius: 4px;
	}

	.status-dot {
		width: 6px;
		height: 6px;
		background: #4ade80;
		border-radius: 50%;
		box-shadow: 0 0 10px #4ade80;
	}

	@media (max-width: 1100px) {
		.header-center { display: none; }
		.nav-btn { display: none; }
	}
</style>
