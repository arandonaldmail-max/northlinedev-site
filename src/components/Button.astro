---
interface Props {
	href?: string;
	variant?: 'tactical' | 'ghost' | 'danger';
	className?: string;
	[x: string]: any;
}

const { href, variant = 'tactical', className = '', ...rest } = Astro.props;

const Element = href ? 'a' : 'button';

const variants = {
	tactical: "btn-tactical",
	ghost: "btn-ghost",
	danger: "btn-danger"
};
---

<Element 
	href={href} 
	class:list={["tactical-button mono", variants[variant], className]}
	{...rest}
>
	<span class="btn-line"></span>
	<span class="btn-content">
		<slot />
	</span>
	<span class="btn-corner"></span>
</Element>

<style>
	.tactical-button {
		position: relative;
		display: inline-flex;
		align-items: center;
		padding: 18px 32px;
		background: transparent;
		color: #fff;
		font-weight: 700;
		cursor: pointer;
		overflow: hidden;
		transition: all 0.3s cubic-bezier(0.19, 1, 0.22, 1);
		border: 1px solid var(--line-heavy);
	}

	.btn-line {
		position: absolute;
		top: 0; left: 0; width: 0%; height: 1px;
		background: var(--tactical-blue);
		transition: width 0.4s ease;
	}

	.tactical-button:hover .btn-line {
		width: 100%;
	}

	.btn-content {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.btn-corner {
		position: absolute;
		bottom: -5px; right: -5px;
		width: 10px; height: 10px;
		background: var(--line-heavy);
		transform: rotate(45deg);
		transition: background 0.3s ease;
	}

	.tactical-button:hover .btn-corner {
		background: var(--tactical-blue);
	}

	/* Variants */
	.btn-tactical {
		background: rgba(255, 255, 255, 0.02);
	}

	.btn-tactical:hover {
		background: rgba(29, 99, 255, 0.05);
		border-color: var(--tactical-blue);
	}

	.btn-ghost {
		border-color: transparent;
	}

	.btn-ghost:hover {
		background: rgba(255, 255, 255, 0.05);
	}

	@media (max-width: 768px) {
		.tactical-button {
			width: 100%;
			justify-content: center;
		}
	}
</style>
