---
import Button from './Button.astro';

const bookingLink = "https://bookings.cloud.microsoft/book/NorthlineDev1@northlinedev.com/?ismsaljsauthenabled";
---

<section class="hero-monolith">
	<div class="container hero-wrap">
		<div class="hero-main">
			<div class="hero-mission reveal">
				<span class="mono text-tactical">Mission Directive // 01</span>
			</div>
			
			<h1 class="hero-h1 reveal" style="animation-delay: 0.1s;">
				Engineered <br/>Market <br/><span class="text-glow">Dominance.</span>
			</h1>

			<p class="hero-p reveal" style="animation-delay: 0.2s;">
				Northline is the industrial-grade growth infrastructure for the world's most ambitious roofing enterprises. We deploy proprietary digital systems that turn market volatility into clinical precision.
			</p>

			<div class="hero-cta reveal" style="animation-delay: 0.3s;">
				<Button href={bookingLink} variant="tactical">Request Deployment</Button>
				<div class="cta-meta">
					<span class="mono">Next Available Slot: Q3 2026</span>
					<span class="mono">Status: Selective Engagement</span>
				</div>
			</div>
		</div>

		<div class="hero-visual reveal" style="animation-delay: 0.4s;">
			<div class="monolith-core">
				<div class="monolith-body">
					<div class="monolith-layer layer-1"></div>
					<div class="monolith-layer layer-2"></div>
					<div class="monolith-layer layer-3"></div>
					<div class="monolith-glow"></div>
				</div>
				<div class="monolith-data">
					<div class="data-stream">
						<span class="mono">Vertical_Integrity_Active</span>
						<span class="mono">Grid_Latency: 0.04ms</span>
						<span class="mono">Core_Temp: Stable</span>
					</div>
				</div>
			</div>
			
			<div class="blueprint-lines">
				<svg width="100%" height="100%" viewBox="0 0 400 400" fill="none">
					<path d="M0 200H400M200 0V400" stroke="var(--line-heavy)" stroke-width="1"/>
					<circle cx="200" cy="200" r="100" stroke="var(--line)" stroke-width="1"/>
					<circle cx="200" cy="200" r="180" stroke="var(--line)" stroke-width="1" stroke-dasharray="8 8"/>
				</svg>
			</div>
		</div>
	</div>
</section>

<style>
	.hero-monolith {
		min-height: 100vh;
		padding-top: 80px;
		display: flex;
		align-items: center;
		position: relative;
		overflow: hidden;
	}

	.hero-wrap {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: var(--s-128);
		align-items: center;
	}

	.hero-mission {
		margin-bottom: var(--s-32);
	}

	.text-tactical { color: var(--tactical-blue); }

	.hero-h1 {
		font-size: clamp(4rem, 10vw, 7.5rem);
		color: #fff;
		margin-bottom: var(--s-48);
	}

	.text-glow {
		color: #fff;
		text-shadow: 0 0 40px var(--tactical-blue);
	}

	.hero-p {
		font-size: 1.25rem;
		max-width: 540px;
		color: var(--steel-dim);
		margin-bottom: var(--s-64);
		line-height: 1.4;
	}

	.hero-cta {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.cta-meta {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.cta-meta span {
		font-size: 0.65rem;
		color: var(--line-heavy);
	}

	/* Monolith Visual */
	.hero-visual {
		position: relative;
		width: 100%;
		aspect-ratio: 1;
		display: grid;
		place-items: center;
	}

	.monolith-core {
		position: relative;
		width: 240px;
		height: 380px;
		z-index: 5;
	}

	.monolith-body {
		position: relative;
		width: 100%;
		height: 100%;
		background: #000;
		border: 1px solid var(--line-heavy);
		overflow: hidden;
	}

	.monolith-layer {
		position: absolute;
		top: 0; left: 0; width: 100%; height: 100%;
		background: linear-gradient(to bottom, transparent, rgba(29, 99, 255, 0.1), transparent);
		animation: scan 4s linear infinite;
	}

	.layer-2 { animation-delay: 1.3s; }
	.layer-3 { animation-delay: 2.6s; }

	@keyframes scan {
		from { transform: translateY(-100%); }
		to { transform: translateY(100%); }
	}

	.monolith-glow {
		position: absolute;
		top: 50%; left: 50%;
		transform: translate(-50%, -50%);
		width: 150%;
		height: 150%;
		background: radial-gradient(circle, var(--tactical-blue-dim) 0%, transparent 70%);
		z-index: -1;
	}

	.monolith-data {
		position: absolute;
		bottom: -64px; left: 0;
		width: 100%;
	}

	.data-stream {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.data-stream span {
		font-size: 0.6rem;
		color: var(--tactical-blue);
		opacity: 0.8;
	}

	.blueprint-lines {
		position: absolute;
		top: 0; left: 0; width: 100%; height: 100%;
		z-index: 1;
	}

	@media (max-width: 1100px) {
		.hero-wrap {
			grid-template-columns: 1fr;
			text-align: center;
			gap: var(--s-64);
		}

		.hero-p { margin-inline: auto; }
		.hero-cta { align-items: center; }
		.monolith-core { width: 180px; height: 300px; }
	}
</style>
