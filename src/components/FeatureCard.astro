---
interface Props {
	title: string;
	description: string;
	icon?: string;
	number?: string;
	variant?: 'tactical' | 'module';
}

const { title, description, icon, number, variant = 'tactical' } = Astro.props;
---

<div class:list={["tactical-card", variant]}>
	<div class="card-frame">
		<div class="card-header">
			{number && <span class="mono text-tactical">{number}</span>}
			<div class="header-line"></div>
		</div>
		
		<div class="card-body">
			{icon && <div class="tactical-icon" set:html={icon} />}
			<h3 class="card-title">{title}</h3>
			<p class="card-desc">{description}</p>
		</div>

		<div class="card-footer">
			<span class="mono status-text">Module_Active</span>
			<div class="footer-corner"></div>
		</div>
	</div>
</div>

<style>
	.tactical-card {
		position: relative;
		background: var(--bg-alt);
		border: 1px solid var(--line-heavy);
		transition: all 0.4s cubic-bezier(0.19, 1, 0.22, 1);
	}

	.tactical-card:hover {
		border-color: var(--tactical-blue);
		transform: translateY(-4px);
		box-shadow: 0 20px 40px -10px rgba(0,0,0,0.5);
	}

	.card-frame {
		padding: var(--s-32);
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.card-header {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-bottom: var(--s-32);
	}

	.text-tactical { color: var(--tactical-blue); font-size: 0.7rem; }

	.header-line {
		flex: 1;
		height: 1px;
		background: var(--line);
	}

	.tactical-icon {
		color: var(--tactical-blue);
		margin-bottom: var(--s-24);
		width: 32px;
		height: 32px;
	}

	.card-title {
		font-size: 1.25rem;
		color: #fff;
		margin-bottom: 12px;
		letter-spacing: -0.02em;
	}

	.card-desc {
		font-size: 0.9rem;
		color: var(--steel-dim);
		line-height: 1.5;
	}

	.card-footer {
		margin-top: auto;
		padding-top: var(--s-32);
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
	}

	.status-text {
		font-size: 0.55rem;
		color: var(--line-heavy);
		transition: color 0.3s ease;
	}

	.tactical-card:hover .status-text {
		color: var(--tactical-blue);
	}

	.footer-corner {
		width: 8px;
		height: 8px;
		border-right: 1px solid var(--line-heavy);
		border-bottom: 1px solid var(--line-heavy);
	}

	.tactical-card:hover .footer-corner {
		border-color: var(--tactical-blue);
	}

	/* Module Variant */
	.module {
		background: rgba(255, 255, 255, 0.01);
	}

	@media (max-width: 768px) {
		.card-frame { padding: var(--s-24); }
	}
</style>
