---
import Button from './Button.astro';

interface Props {
	title: string;
	price: string;
	period?: string;
	description: string;
	features: string[];
	ctaLabel: string;
	ctaLink: string;
	highlight?: boolean;
}

const { title, price, period, description, features, ctaLabel, ctaLink, highlight = false } = Astro.props;
---

<div class:list={["tactical-tier", { "highlight": highlight }]}>
	<div class="tier-inner">
		<div class="tier-head">
			<h3 class="mono text-tactical">{title}</h3>
			<div class="price-wrap">
				<span class="currency">&euro;</span>
				<span class="amount">{price}</span>
				{period && <span class="mono period">/{period}</span>}
			</div>
			<p class="desc">{description}</p>
		</div>

		<div class="tier-body">
			<ul class="feat-list">
				{features.map(f => (
					<li>
						<div class="feat-dot"></div>
						<span>{f}</span>
					</li>
				))}
			</ul>
		</div>

		<div class="tier-foot">
			<Button href={ctaLink} variant={highlight ? 'tactical' : 'ghost'} className="w-full">
				{ctaLabel}
			</Button>
		</div>
	</div>
	
	<div class="tier-frame"></div>
</div>

<style>
	.tactical-tier {
		position: relative;
		background: var(--bg-alt);
		border: 1px solid var(--line-heavy);
		padding: var(--s-64) var(--s-40);
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.tactical-tier.highlight {
		border-color: var(--tactical-blue);
		background: rgba(29, 99, 255, 0.02);
		box-shadow: 0 40px 80px -20px rgba(0,0,0,0.6);
	}

	.text-tactical { color: var(--tactical-blue); font-size: 0.75rem; margin-bottom: 24px; display: block; }

	.price-wrap {
		display: flex;
		align-items: baseline;
		gap: 4px;
		margin-bottom: 16px;
		color: #fff;
	}

	.currency { font-size: 1.5rem; font-weight: 700; }
	.amount { font-size: 4.5rem; font-weight: 900; letter-spacing: -0.05em; line-height: 1; }
	.period { font-size: 0.8rem; color: var(--steel-dim); }

	.desc { font-size: 0.95rem; color: var(--steel-dim); margin-bottom: var(--s-48); }

	.feat-list { list-style: none; display: grid; gap: 12px; margin-bottom: var(--s-64); }
	.feat-list li { display: flex; align-items: center; gap: 12px; font-size: 0.85rem; color: var(--steel); font-weight: 600; }
	.feat-dot { width: 4px; height: 4px; background: var(--tactical-blue); transform: rotate(45deg); flex-shrink: 0; }

	.tier-foot { margin-top: auto; }
	.w-full { width: 100%; }

	.tier-frame {
		position: absolute;
		top: 0; left: 0; width: 100%; height: 100%;
		pointer-events: none;
		border: 1px solid transparent;
		transition: all 0.3s ease;
	}

	.tactical-tier:hover .tier-frame {
		border-color: var(--line-heavy);
		transform: scale(1.02);
	}

	@media (max-width: 768px) {
		.tactical-tier { padding: var(--s-48) var(--s-24); }
		.amount { font-size: 3.5rem; }
	}
</style>
